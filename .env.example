# ─────────────────────────────────────────────
#  IT Slack Bot — Environment Variables
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Slack App credentials (from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here   # Only needed for Socket Mode

# The channel to monitor (use the channel ID, e.g. C01234ABCDE)
IT_CHANNEL_ID=C01234ABCDE

# The two IT responders to tag (use Slack user IDs, e.g. U01234ABCDE)
RESPONDER_1_ID=U01234ABCDE
RESPONDER_2_ID=U56789FGHIJ

# Redis connection (BullMQ job queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Port for the HTTP server (used in Events API / HTTP mode)
PORT=3000

# Optional: set to "socket" for Socket Mode (dev), "http" for production
SLACK_MODE=socket
